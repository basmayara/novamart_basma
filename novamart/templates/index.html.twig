<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - NovaMart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --nm-primary: #0d9488;
            --nm-primary-dark: #0f766e;
            --nm-accent: #f59e0b;
        }
        .navbar { background-color: var(--nm-primary-dark) !important; }
        .btn-nm { background-color: var(--nm-primary); color: #fff; border: none; }
        .btn-nm:hover { background-color: var(--nm-primary-dark); color: #fff; }
        .btn-outline-nm { border: 1px solid var(--nm-primary); color: var(--nm-primary); }
        .btn-outline-nm:hover { background-color: var(--nm-primary); color: #fff; }
        .card:hover { box-shadow: 0 4px 20px rgba(13,148,136,.2); transform: translateY(-2px); transition: .2s; }
        footer { background-color: var(--nm-primary-dark) !important; }
    </style>
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">🛒 NovaMart</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart') }}">🛍️ Cart</a>
                    </li>
                    {% if app.user %}
                        <li class="nav-item">
                            <span class="nav-link text-white">Hi, {{ app.user.firstName }}!</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Products Section -->
    <div class="container my-5">
        <h1 class="mb-4 fw-bold" style="color: var(--nm-primary-dark, #0f766e);">Our Products</h1>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <!-- Product 1 -->
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('product_images/smartwatch.png') }}" class="card-img-top" alt="Smartwatch Pro" style="height:220px; object-fit:cover;">
                    <div class="card-body">
                        <span class="badge mb-2" style="background:#0d9488">Wearables</span>
                        <h5 class="card-title">Smartwatch Pro</h5>
                        <p class="card-text fw-bold" style="color:#0d9488">$129.99</p>
                        <a href="details.html?id=1" class="btn btn-outline-nm">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Product 2 -->
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('product_images/sneakers.png') }}" class="card-img-top" alt="Urban Sneakers" style="height:220px; object-fit:cover;">
                    <div class="card-body">
                        <span class="badge bg-warning text-dark mb-2">Footwear</span>
                        <h5 class="card-title">Urban Sneakers</h5>
                        <p class="card-text fw-bold" style="color:#0d9488">$89.99</p>
                        <a href="details.html?id=2" class="btn btn-outline-nm">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Product 3 -->
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('product_images/lamp.png') }}" class="card-img-top" alt="Desk Lamp LED" style="height:220px; object-fit:cover;">
                    <div class="card-body">
                        <span class="badge bg-success mb-2">Home & Decor</span>
                        <h5 class="card-title">Desk Lamp LED</h5>
                        <p class="card-text fw-bold" style="color:#0d9488">$44.99</p>
                        <a href="details.html?id=3" class="btn btn-outline-nm">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Product 4 -->
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('product_images/yoga.png') }}" class="card-img-top" alt="Yoga Bundle" style="height:220px; object-fit:cover;">
                    <div class="card-body">
                        <span class="badge bg-info mb-2">Fitness</span>
                        <h5 class="card-title">Yoga Bundle</h5>
                        <p class="card-text fw-bold" style="color:#0d9488">$39.99</p>
                        <a href="details.html?id=4" class="btn btn-outline-nm">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Product 5 -->
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('product_images/speaker.png') }}" class="card-img-top" alt="Portable Speaker" style="height:220px; object-fit:cover;">
                    <div class="card-body">
                        <span class="badge mb-2" style="background:#0d9488">Audio</span>
                        <h5 class="card-title">Portable Speaker</h5>
                        <p class="card-text fw-bold" style="color:#0d9488">$69.99</p>
                        <a href="details.html?id=5" class="btn btn-outline-nm">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Product 6 -->
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('product_images/cookbook.png') }}" class="card-img-top" alt="Gourmet Cookbook" style="height:220px; object-fit:cover;">
                    <div class="card-body">
                        <span class="badge bg-danger mb-2">Books</span>
                        <h5 class="card-title">Gourmet Cookbook</h5>
                        <p class="card-text fw-bold" style="color:#0d9488">$27.99</p>
                        <a href="details.html?id=6" class="btn btn-outline-nm">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>🛒 NovaMart</h5>
                    <p>Fresh finds, smart prices.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; 2026 NovaMart. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
