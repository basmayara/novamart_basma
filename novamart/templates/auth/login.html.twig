<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - NovaMart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --nm-primary: #0d9488; --nm-primary-dark: #0f766e; }
        .navbar { background-color: var(--nm-primary-dark) !important; }
        footer { background-color: var(--nm-primary-dark) !important; }
        .btn-nm { background-color: var(--nm-primary); color: #fff; border: none; }
        .btn-nm:hover { background-color: var(--nm-primary-dark); color: #fff; }
        .btn-nm-success { background-color: #059669; color: #fff; border: none; }
        .btn-nm-success:hover { background-color: #047857; color: #fff; }
        .card-header-nm { background-color: var(--nm-primary) !important; }
        .bg-nm-light { background-color: #f0fdfa !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">🛒 NovaMart</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_cart') }}">🛍️ Cart</a></li>
                    {% if app.user %}
                        <li class="nav-item">
                            <span class="nav-link text-white">Hi, {{ app.user.firstName }}!</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link active" href="{{ path('app_login') }}">Login</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow">
                    <div class="row g-0">

                        <!-- Login Form -->
                        <div class="col-md-6">
                            <div class="card-body p-5">
                                <h2 class="card-title mb-4">Sign In to NovaMart</h2>

                                {% if error %}
                                    <div class="alert alert-danger">{{ error.messageKey|trans }}</div>
                                {% endif %}

                                <form method="post" action="{{ path('app_login_check') }}">
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email address</label>
                                        <input type="email" name="_username" class="form-control"
                                               id="email" value="{{ last_username }}"
                                               placeholder="your@email.com" required autofocus>
                                    </div>
                                    <div class="mb-3">
                                        <label for="password" class="form-label">Password</label>
                                        <input type="password" name="_password" class="form-control"
                                               id="password" placeholder="Enter your password" required>
                                    </div>
                                    <div class="mb-3 form-check">
                                        <input type="checkbox" class="form-check-input" id="rememberMe" name="_remember_me">
                                        <label class="form-check-label" for="rememberMe">Remember me</label>
                                    </div>
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-nm btn-lg">Sign In</button>
                                    </div>
                                </form>
                                <hr class="my-4">
                                <p class="text-center text-muted">
                                    New to NovaMart?
                                    <a href="#register" style="color:#0d9488; text-decoration:none;">Create an account</a>
                                </p>
                            </div>
                        </div>

                        <!-- Register Form -->
                        <div class="col-md-6 bg-nm-light" id="register">
                            <div class="card-body p-5">
                                <h2 class="card-title mb-4">Create Account</h2>

                                {{ form_start(registrationForm, {'action': path('app_register'), 'method': 'POST'}) }}
                                    <div class="mb-3">
                                        <label class="form-label">First Name</label>
                                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Your first name'}}) }}
                                        {{ form_errors(registrationForm.firstName) }}
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Last Name</label>
                                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Your last name'}}) }}
                                        {{ form_errors(registrationForm.lastName) }}
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'your@email.com'}}) }}
                                        {{ form_errors(registrationForm.email) }}
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Password</label>
                                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Create a password'}}) }}
                                        {{ form_errors(registrationForm.plainPassword.first) }}
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Confirm Password</label>
                                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirm password'}}) }}
                                        {{ form_errors(registrationForm.plainPassword) }}
                                    </div>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-nm-success btn-lg">Join NovaMart</button>
                                    </div>
                                {{ form_end(registrationForm) }}
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>🛒 NovaMart</h5>
                    <p>Fresh finds, smart prices.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; 2026 NovaMart. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
